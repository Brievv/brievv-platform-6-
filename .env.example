# ============================================================
# BRIEVV — Environment Variables
# Copy to .env.local (dev) or configure in your hosting provider
# (production). Never commit real values.
# ============================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=BRIEVV

# --- Database (PostgreSQL via Prisma) ---
# Local dev example: postgresql://postgres:postgres@localhost:5432/brievv
DATABASE_URL=

# --- Auth (NextAuth.js) ---
AUTH_SECRET=              # openssl rand -base64 32 — also used to derive the MFA secret-encryption key (see src/server/services/mfa/mfa.ts)
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# --- AI Provider (server-side ONLY — never expose to the browser) ---
AI_PROVIDER=anthropic       # anthropic | openai
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=1200
AI_ESTIMATOR_TEMPERATURE=0.3

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=15

# --- File storage (S3-compatible: AWS S3 / Cloudflare R2 / Supabase Storage) ---
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=brievv-files
S3_PUBLIC_BASE_URL=

# --- Malware scanning (optional — files stay "pending" review until set) ---
MALWARE_SCAN_PROVIDER=            # unset | clamav | virustotal

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="BRIEVV <notifications@brievv.com>"

# --- Background jobs / cache ---
REDIS_URL=

# --- Security ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- Feature flags ---
# MFA is a per-user opt-in (Settings > Security) and needs no flag here.
ENABLE_SMS_NOTIFICATIONS=false
